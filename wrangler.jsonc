{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mt5-online-index",
  "main": "./dist/server/index.js",
  "account_id": "bf7a76ed2c6515376aca886a0479a064",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mt5-online-index-db",
      "database_id": "19a6ded2-b7ea-4d4b-9103-28899667ead5",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
